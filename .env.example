DATABASE_URL=        # Neon connection string
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Admin API (server-only; required for /api/migrate-gallery-tags tagging). Prefer these names over duplicating secrets.
CLOUDINARY_CLOUD_NAME=         # optional if same as NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=   # server-side Distance Matrix API key (same value as NEXT_PUBLIC_GOOGLE_PLACES_API_KEY)
APP_PASSWORD=        # e.g. gardens2024

# Clerk — embedded sign-in (keeps users on your domain)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
